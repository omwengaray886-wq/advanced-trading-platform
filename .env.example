# ============================================================
# Advanced Trading Platform — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# JWT Secret — MUST be changed in production (use a long random string)
# Generate one at: https://generate-secret.vercel.app/64
JWT_SECRET=your-super-secret-jwt-key-change-this-to-random-64-chars

# Admin Panel Password — used to access /admin
ADMIN_PASSWORD=your-admin-password-here

# Gemini AI API Key (for /api/ai/generate)
GEMINI_API_KEY=your-gemini-api-key

# Binance API Keys (optional — for trading features)
# BINANCE_API_KEY=your-binance-api-key
# BINANCE_API_SECRET=your-binance-secret

# CoinGecko API Key (for indices/market data)
COINGECKO_API_KEY=your-coingecko-api-key

# News APIs
NEWS_API_KEY=your-newsapi-key
FMP_API_KEY=your-financialmodelingprep-key
CRYPTOPANIC_API_KEY=your-cryptopanic-key

# Firebase Admin (for background-worker.js)
# Path to your firebase-admin-key.json file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-admin-key.json

# Background Worker Settings
WORKER_INTERVAL=15

# Node environment
NODE_ENV=development
